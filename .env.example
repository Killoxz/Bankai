# ---- App ----
NEXT_PUBLIC_APP_NAME=Bankai
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Data source ----
# "mock"   -> runs fully offline with bundled demo data (default, no keys needed)
# "anilist"-> live AniList GraphQL
# "jikan"  -> live Jikan (MyAnimeList) REST
DATA_PROVIDER=mock
NEXT_PUBLIC_DATA_PROVIDER=mock

# ---- Streaming (Anivexa / Zenin API) ----
# Fork: https://github.com/DTPW/Zenin-API  (based on walterwhite-69/Anivexa-API)
# Deploy on Railway/Render (NOT Vercel — streaming sites block datacenter IPs).
# Set this to your deployed instance URL, e.g. https://zenin-api.up.railway.app
STREAMING_API_URL= zenin-api-production.up.railway.app

# Optional: TMDB for trailers/backdrops
TMDB_API_KEY=

# ---- Database (Prisma / PostgreSQL) ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bankai?schema=public"

# ---- Media storage (Vercel Blob) ----
# Vercel dashboard -> Storage -> create a Blob store (adds this automatically
# in production). For local dev, pull it down or paste it here.
# Without it, profile picture/banner uploads return a clear error instead of crashing.
BLOB_READ_WRITE_TOKEN=

# ---- NextAuth (Auth.js v5) ----
# Generate: openssl rand -base64 32
AUTH_SECRET=changeme-in-production
AUTH_TRUST_HOST=true

# OAuth providers (all optional — leave blank to hide that button)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ---- Redis (optional caching) ----
REDIS_URL=
